# Place4U Environment Configuration
# Copy this file to .env and supply your credentials

# Supabase Project Credentials (required for client-side authentication and queries)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# PayPal Configuration (Application Vetting Fee)
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id
VITE_PAYPAL_ENVIRONMENT=live
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENVIRONMENT=live
VITE_APPLICATION_FEE_ZAR=100
