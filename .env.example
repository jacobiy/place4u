# Place4U Environment Configuration
# Copy this file to .env and supply your credentials.
#
# Each environment (dev / uat / production) needs its OWN values. The Vite build
# inlines these into the bundle, so a dev/uat build must point at a
# non-production Supabase project and use PayPal SANDBOX credentials.

# Supabase Project Credentials (required; the build fails without these)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Canonical site origin used for SEO (canonical links, og:url, sitemap refs).
# Optional - defaults to https://place4u.xyz when unset. Set it to a dev/uat
# origin only if that environment should advertise itself as canonical.
VITE_SITE_URL=https://place4u.xyz

# PayPal Configuration (Application Vetting Fee)
# Use VITE_PAYPAL_ENVIRONMENT=sandbox for dev/uat and =live for production only.
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id
VITE_PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENVIRONMENT=sandbox
VITE_APPLICATION_FEE_ZAR=100
